# --- Client (exposed to the browser, must be VITE_ prefixed) ---
# Google Maps JavaScript API key, restricted by HTTP referrer.
# Enable: Maps JavaScript API
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=

# --- Server only (never exposed) ---
# Used by src/lib/api/commute.functions.ts for Geocoding + Routes matrix calls
# through the Lovable connector gateway. If you are self-hosting off Lovable,
# see README "Going off the Lovable gateway".
LOVABLE_API_KEY=
GOOGLE_MAPS_API_KEY=
